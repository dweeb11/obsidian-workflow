# Per-machine Obsidian state (window layout, open files, graph view) — churn and merge conflicts
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/app.json
.obsidian/plugins/
.obsidian/themes/
.obsidian/snippets/

# Local agent settings
.claude/settings.local.json
.claude/worktrees/

# Python
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Generated per-tool skill adapters ARE committed, so a fresh clone works with no
# install step. Negated explicitly because a global gitignore commonly excludes
# .cursor/ -- without this the repo would silently ship Claude adapters only,
# which is the exact single-tool drift the registry exists to prevent.
!.cursor/
!.cursor/rules/
!.claude/skills/
!.claude/settings.json
