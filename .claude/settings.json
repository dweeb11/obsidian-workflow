{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/system/scripts/session-start-context.py\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/system/scripts/sync-check.py\" --check --quiet-when-clean"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/system/scripts/generate-adapters.py\" --check --quiet-when-clean"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/system/scripts/session-end-route.py\" --from-hook"
          }
        ]
      }
    ]
  }
}
